{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": "vite",
  "routes": [
    {
      "src": "/(.*)",
      "headers": {
        "X-Content-Type-Options": "nosniff",
        "Referrer-Policy": "strict-origin-when-cross-origin",
        "Permissions-Policy": "camera=(), microphone=(), geolocation=()",
        "X-Frame-Options": "SAMEORIGIN"
      },
      "continue": true
    },
    {
      "src": "/(img|plaka/video)/(.*)",
      "headers": { "Cache-Control": "public, max-age=31536000, immutable" },
      "continue": true
    },
    {
      "src": "/chat-api\\.php",
      "dest": "/api/chat-api.js"
    },
    {
      "src": "/api/plaka-anahtar",
      "dest": "/api/plaka-anahtar.js"
    },
    {
      "src": "/hakkimizda/?",
      "dest": "/hakkimizda.html"
    },
    {
      "src": "/iletisim/?",
      "dest": "/iletisim.html"
    },
    {
      "src": "/referanslar/?",
      "dest": "/referanslar.html"
    },
    {
      "src": "/pdks-programi/?",
      "dest": "/pdks-programi.html"
    },
    {
      "src": "/plaka-okuma/?",
      "dest": "/plaka-okuma.html"
    },
    {
      "src": "/qr-bekci/?",
      "dest": "/qr-bekci.html"
    },
    {
      "src": "/urunler/turnike/?",
      "dest": "/urunler/turnike.html"
    },
    {
      "src": "/en/?",
      "dest": "/en.html"
    },
    {
      "src": "/en/about/?",
      "dest": "/en/about.html"
    },
    {
      "src": "/en/contact/?",
      "dest": "/en/contact.html"
    },
    {
      "src": "/en/references/?",
      "dest": "/en/references.html"
    },
    {
      "src": "/en/time-attendance/?",
      "dest": "/en/time-attendance.html"
    },
    {
      "src": "/en/anpr/?",
      "dest": "/en/anpr.html"
    },
    {
      "src": "/en/guard-tour/?",
      "dest": "/en/guard-tour.html"
    },
    {
      "src": "/en/turnstiles/?",
      "dest": "/en/turnstiles.html"
    },
    {
      "src": "/tr/?",
      "status": 301,
      "headers": { "Location": "/" }
    },
    {
      "src": "/cozumler/pdks/?",
      "status": 301,
      "headers": { "Location": "/pdks-programi" }
    },
    {
      "src": "/personel-devam-kontrol-sistemi/?",
      "status": 301,
      "headers": { "Location": "/pdks-programi" }
    },
    {
      "src": "/turnike-sistemleri/?",
      "status": 301,
      "headers": { "Location": "/urunler/turnike" }
    },
    {
      "src": "/cozumler/bekci-kontrol/?",
      "status": 301,
      "headers": { "Location": "/qr-bekci" }
    },
    {
      "src": "/urunler/bekci-tur-kontrol/?",
      "status": 301,
      "headers": { "Location": "/qr-bekci" }
    },
    {
      "src": "/parmak-izi-takip-sistemi/?",
      "status": 301,
      "headers": { "Location": "/urunler/parmak-izi-tanima" }
    },
    {
      "src": "/yuz-tanima-sistem/?",
      "status": 301,
      "headers": { "Location": "/urunler/yuz-tanima" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/mobil-gizlilik-sozlesmesi\\.php",
      "dest": "/spa.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
