{
  "buildCommand": "npm run build",
  "outputDirectory": "dist/public",
  "installCommand": "npm install",
  "framework": "vite",
  "routes": [
    {
      "src": "/chat-api\\.php",
      "dest": "/api/chat-api.js"
    },
    {
      "src": "/api/plaka-anahtar",
      "dest": "/api/plaka-anahtar.js"
    },
    {
      "src": "/cozumler/pdks/?",
      "status": 301,
      "headers": { "Location": "/pdks-programi" }
    },
    {
      "src": "/personel-devam-kontrol-sistemi/?",
      "status": 301,
      "headers": { "Location": "/pdks-programi" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/mobil-gizlilik-sozlesmesi\\.php",
      "dest": "/spa.html"
    },
    {
      "src": "/(.*)",
      "dest": "/404.html",
      "status": 404
    }
  ]
}
